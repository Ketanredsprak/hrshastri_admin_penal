<?php

namespace App\Exports;

use App\Models\Employee;
use App\Models\TimeSheet;
use Illuminate\Support\Facades\Auth;
use Maatwebsite\Excel\Concerns\FromCollection;
use Maatwebsite\Excel\Concerns\WithHeadings;

class TimesheetReportExport implements FromCollection, WithHeadings
{
    /**
     * @return \Illuminate\Support\Collection
     */
    public function collection()
    {
        if (Auth::user()->type == 'company') {
            $data = TimeSheet::where('created_by', Auth::user()->creatorId())->get();
        } else {
            $assign_employees = json_decode(Auth::user()->assign_employees) ?? [];
            $data = TimeSheet::where('created_by', Auth::user()->creatorId())->whereHas('employees',function($q) use($assign_employees){
                $q->whereIn('employee_id',$assign_employees);
            })->get();
        }

        foreach ($data as $k => $timesheet) {
            $data[$k]["employee_id"] = !empty($timesheet->employees) ? $timesheet->employees->name : '';
            $data[$k]["created_by"] = Employee::login_user($timesheet->created_by);
            unset($timesheet->created_at, $timesheet->updated_at, $timesheet->created_by);
        }
        return $data;
    }
    public function headings(): array
    {
        return [
            "ID",
            "Employee Name",
            "Date",
            "Hour",
            "Remark",
        ];
    }
}
