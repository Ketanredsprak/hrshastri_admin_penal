               if (!empty($payslip))
               {
                    $net_payble = \Auth::user()->priceFormat($payslip->net_payble);
                    // $payslipDetail = Utility::employeePayslipDetail($row->id,$payslip->play_slab_id,$payslip);
                    // if(!empty($payslipDetail))
                    // {
                    //     $totalEarning = $payslipDetail['totalEarning'];
                    //     $totalDeduction = $payslipDetail['totalDeduction'];
                    // }
               }

               $row->attdebdance  = $employeeAttendance;
               $dataRow[] = [
                    'id'                => $row->id,
                    'name'              => $row->name,
                    'employee_code'     => Auth::user()->employeeIdFormat($row->id),
                    'gender'            => $row->gender,
                    'attdebdance'       => $row->attdebdance,
                    'salary'            => \Auth::user()->priceFormat($row->salary),
                    'Sp. Allow'         => \Auth::user()->priceFormat($totalEarning),
                    'HRA'               => \Auth::user()->priceFormat(0),
                    'Perf. Bonus'       => \Auth::user()->priceFormat(0),
                    'Special Allowance' => \Auth::user()->priceFormat($totalEarning),
                    'Arrears'           => \Auth::user()->priceFormat(0),
                    'Attn. Bonus'       => \Auth::user()->priceFormat(0),
                    'Arrears1'          => \Auth::user()->priceFormat(0),
                    'Arrears2'          => \Auth::user()->priceFormat(0),
                    'Ot Hrs'            => \Auth::user()->priceFormat(0),
                    'Ot Wages'          => \Auth::user()->priceFormat(0),
                    'Earnings'          => \Auth::user()->priceFormat($totalEarning),
                    'PF'                => \Auth::user()->priceFormat(0),
                    'ESIC'                 => \Auth::user()->priceFormat(0),
                    'PT'                   => \Auth::user()->priceFormat(0),
                    'IT'                   => \Auth::user()->priceFormat(0),
                    'LWF'                  => \Auth::user()->priceFormat(0),
                    'Loan'                 => \Auth::user()->priceFormat(0),
                    'Advance'              => \Auth::user()->priceFormat(0),
                    'Security Deposit'     => \Auth::user()->priceFormat(0),
                    'Other'                => \Auth::user()->priceFormat(0),
                    'Deduction'            => \Auth::user()->priceFormat($totalDeduction),
                    'net_payble'           => $net_payble,
