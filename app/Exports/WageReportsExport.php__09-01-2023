class WageReportsExport implements FromCollection, WithHeadings, WithStyles
{

     public function collection()
     {
          $data = Employee::where('created_by', \Auth::user()->creatorId())->get();
          $employees = Employee::where('created_by', \Auth::user()->creatorId())
               ->where('company_doj', '<=', "2021-10-01")
               ->get();

          $dataRow = [];

          foreach ($data as $row)
          {
               $net_payble = 0;
               $totalEarning = 0;
               $totalDeduction = 0;
               $employeeAttendance = AttendanceEmployee::where('employee_id', $row->id)->count();
