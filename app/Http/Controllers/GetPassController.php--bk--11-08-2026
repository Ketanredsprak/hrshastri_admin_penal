     public function changeactionupdate(request $request)
     {
          try
          {
               DB::beginTransaction();
               $data = GetPass::find($request->leave_id);
               $employee = Employee::where('id', $data->employee_id)->first();
               $upUser = User::where('assign_employees', '!=', null)->where('created_by', '=', Auth::user()->creatorId())->select('assign_employees', 'id')->get();
               if ($request->status == 'Approved')
               {
                    $data->status = 1;
               }
               else
               {
                    $data->status = 2;
               }
               $data->save();

               //notification Code
               foreach ($upUser as $row)
               {
                    foreach (json_decode($row['assign_employees']) ?? [] as $key => $user)
                    {
                         if (!empty($user))
                         {
                              if ($user == $employee->id)
                              {
                                   $notification   = new NotificationModel();
                                   if ($row->id != Auth::id())
                                   {
                                        $notification->user_id = $row->id;
                                        $notification->redirect     = 'getpass';
                                   }
                                   else
                                   {
                                        $notification->user_id      = $employee->user_id;
                                        $notification->redirect     = 'getpass_employee';
                                   }

                                   $status = ($request->status == "Reject" ? "Rejected" : $request->status);

                                   $notification->action_status = $status;
                                   $notification->employee_id  = $employee->id;
                                   $notification->title        = 'Gate pass request ' . $status . ' by ' . Auth::user()->name;
                                   $notification->details        = 'Gate pass request ' . $status . ' by ' . Auth::user()->name;
                                   // $notification->title        = $employee->name  . "Gate pass "  .  $status . ' : ' . User::find(auth::id())->name  .  " ";
                                   $notification->status       = 0;
                                   // $notification->date         = Carbon::now();
                                   $notification->date         = date("Y-m-d H:i:d", strtotime($data->date));
                                   $notification->created_by   = $employee->created_by;
                                   $notification->save();
                              }
                         }
                    }
               }
               //end notification

               // Send Push Notification to App
               if (in_array($data->status, [1, 2]))
               {
                    $usersData = User::where("id", $employee->user_id)->where("device_token", "!=", NULL)->select("id", "device_type", "device_token")->get();

                    if (!$usersData->isEmpty())
                    {
                         $statusArray = [
                              "1" => "Approved",
                              "2" => "Rejected",
                         ];

                         $gatePassText = ($data->name == 1 ? __("Personal Work") : __("Office Work"));
                         $title = __("Your Gate Pass for $gatePassText has been " . $statusArray[$data->status]);
                         $body = __("Your Gate Pass for $gatePassText has been " . $statusArray[$data->status]);

                         $click_action = "gate_pass_status_changed";
                         $extraData = ["id" => $data->id];

                         sendpPushNotification($title, $body, $usersData, $click_action, $extraData);
                    }
               }
               // Send Push Notification to App

               DB::commit();
               return redirect()->route('getpass_request')->with('success', __('Gete pass status successfully updated.'));
          }
          catch (Exception $ex)
          {
               DB::rollBack();
               return redirect()->route('getpass.index')->with('error', $ex->getMessage());
          }
          catch (Throwable $ex)
          {
               DB::rollBack();
               return redirect()->route('getpass.index')->with('error', $ex->getMessage());
          }
     }
