     public function store(Request $request)
     {
          try
          {
               DB::beginTransaction();
               $inTime = $request->in_time;
               $outTime = $request->out_time;
               $employeeId = '';

               $employee = Employee::where('user_id', '=', Auth::user()->id)->first();

               $data               = new GetPass();
               $data->name         = $request->leave_type_id;
               $data->employee_id  = $employee->id;
               $data->date         = $request->start_date;
               $data->in_time   = $inTime;
               $data->out_time  = $outTime;
               $data->resone    = $request->leave_reason;
               $data->veryfy_status    = 0;
               $data->status    = 0;
               $data->created_by   = Auth::user()->creatorId();
               $data->save();

               //notification Code
               $employee = Employee::where('user_id', '=', Auth::id())->first();
               $upUser = User::where('assign_employees', '!=', null)->where('created_by', '=', Auth::user()->creatorId())->select('assign_employees', 'id')->get();
               foreach ($upUser as $row)
               {
                    foreach (json_decode($row['assign_employees']) ?? [] as $key => $user)
                    {
                         if (!empty($user))
                         {
                              if ($user == $employee->id)
                              {
                                   $notification               = new NotificationModel();
                                   $notification->user_id      = $row->id;
                                   $notification->employee_id  = $employee->id;
                                   $notification->title        = "Gate pass applied by " . $employee->name . " ";
                                   $notification->details      = "Gate pass applied by " . $employee->name . " ";
                                   $notification->status       = 0;
                                   // $notification->date         = Carbon::now();
                                   $notification->date         = date("Y-m-d H:i:d", strtotime($request->start_date));
                                   $notification->created_by   = $employee->created_by;
                                   $notification->redirect   = 'getpass';
                                   $notification->save();
                              }
                         }
                    }
               }
               //end notification
               DB::commit();
               return redirect()->route('getpass.index')->with('success', __('Gete pass successfully created.'));
          }
          catch (Exception $ex)
          {
               DB::rollBack();
               return redirect()->route('getpass.index')->with('error', $ex->getMessage());
          }
          catch (Throwable $ex)
          {
               DB::rollBack();
               return redirect()->route('getpass.index')->with('error', $ex->getMessage());
          }
     }

