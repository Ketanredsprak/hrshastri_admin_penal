     public function getpass_request(Request $request)
     {
          $getpass = 0;
          $employees = Employee::where('created_by', Auth::user()->creatorId())->get();
          //$getpass     = GetPass::with('employee')->whereIn('employee_id', selectedEmployee())->where('created_by', '=', Auth::user()->creatorId())->orderBy('id', 'DESC')->get();

          $getpass = GetPass::with('employee')->whereIn('employee_id', selectedEmployee())->where('created_by', Auth::user()->creatorId())->where('created_at', '>=', Carbon::now()->subMonths(4)->startOfDay())->orderBy('id', 'DESC');
          if ($request->ajax())
          {
               $data = $getpass;
               return Datatables::of($data)
                    ->addIndexColumn()

                    ->addColumn('employee_id', function ($row)
                    {
                         return ((Auth::user()->hasPermissionTo('Show Employee')) ? '<a class="btn btn-outline-primary" href=" ' . route('employee.show', Crypt::encrypt($row->id)) . '">' . $row->employee->employee_id . '</a>' : $row->employee->employee_id);
                    })
                    ->addColumn('employee', function ($row)
                    {
                         return $row->employee->name ?? "";
                    })
                    ->addColumn('date', function ($row)
                    {
                         return !empty($row->date) ? Auth::user()->dateFormat($row->date) : '';
                    })
                    ->addColumn('type', function ($row)
                    {
                         return ($row->name == 1) ? 'Personal Work' : 'Office Work';
                    })
                    ->addColumn('in_time', function ($row)
                    {
                         return !empty($row->in_time) ? $row->in_time : '';
                    })
                    ->addColumn('out_time', function ($row)
                    {
                         return !empty($row->out_time) ? $row->out_time : '';
                    })
                    ->addColumn('reason', function ($row)
                    {
                         return !empty($row->resone) ? $row->resone : '';
                    })
                    ->addColumn('status', function ($row)
                    {
                         if ($row->status == 0)
                         {
                              $status = '<span class="badge bg-primary p-2 px-3 rounded">' . __('Pending') . '</span>';
                         }
                         elseif ($row->status == 1)
                         {
                              $status = '<span class="badge bg-success p-2 px-3 rounded">' . __('Approved') . '</span>';
                         }
                         elseif ($row->status == 2)
                         {
                              $status = '<span class="badge bg-danger p-2 px-3 rounded">' . __('Reject') . '</span>';
                         }
                         return $status;
                    })
                    ->filterColumn('employee', function ($query, $keyword)
                    {
                         $query->whereHas('employee', function ($q) use ($keyword)
                         {
                              $q->where('name', 'like', "%{$keyword}%");
                         });
                    })
                    ->filterColumn('employee_id', function ($query, $keyword)
                    {
                         $query->whereHas('employee', function ($q) use ($keyword)
                         {
                              $q->where('employee_id', 'like', "%{$keyword}%");
                         });
                    })

                    ->addColumn('action', function ($row)
                    {
                         $url = url('getpass_changeaction/' . $row->id);
                         $title = __('Gate Pass Action');
                         $tooltip = __('Manage Gate Pass');

                         return '
                              <div class="action-btn bg-success ms-2">
                                   <a href="#" class="mx-3 btn btn-sm align-items-center"
                                        data-size="lg"
                                        data-url="' . $url . '"
                                        data-ajax-popup="true"
                                        data-size="md"
                                        data-bs-toggle="tooltip"
                                        title=""
                                        data-title="' . $title . '"
                                        data-bs-original-title="' . $tooltip . '">
                                        <i class="ti ti-caret-right text-white"></i>
                                   </a>
                              </div>';
                    })
                    ->rawColumns(['employee_id', 'employee', 'start_date', 'end_date', 'status', 'action'])
                    ->make(true);
          }
          else
          {
               $getpass = $getpass->get();
               return view('getpass.getpass_request', compact('getpass'));
          }
     }

