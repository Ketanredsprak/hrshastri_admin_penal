     public function addMonthlyLeave(Request $request)
     {
          Log::channel('employee_leave_balance_operations_log')->info("add Monthly Leave Cron Job Hit");

          try
          {
               $data = Employee::select(
                    "id",
                    "name",
                    "probation_period_date",
                    "confirm_probation_period",
                    "play_slab_id",
                    "created_by",
                    "employe_status",
               )
                    ->where('employe_status', "Active")
                    ->where("id", 167)
                    ->get();

               $leaveAddedCount = 0;
               foreach ($data as $employee)
               {
                    $probation_period_date = $employee->getRawOriginal("probation_period_date");
                    $confirm_probation_period = $employee->confirm_probation_period;

                    $addLeave = 0;

                    if (
                         date("Y-m-d") > date("Y-m-d", strtotime($probation_period_date)) &&
                         (empty($confirm_probation_period) || $confirm_probation_period == null)
                    )
                    {
                         $leaveTypes = LeaveType::where("play_slab_id", $employee->play_slab_id)->where('created_by', '=', $employee->created_by)->get();

                         foreach ($leaveTypes as $leaveType)
                         {
                              $addLeave = ($leaveType->days / 12);

                              // Add Leave Balance
                              $userLeaveBalance = UserLeaveBalance::where([
                                   ["user_id", "=", $employee->id],
                                   ["leave_type_id", "=", $leaveType->id],
                              ])->first();

                              if (empty($userLeaveBalance))
                              {
                                   $userLeaveBalance = new UserLeaveBalance();

                                   $userLeaveBalance->user_id = $employee->id;
                                   $userLeaveBalance->leave_type_id = $leaveType->id;
                                   $userLeaveBalance->pending_leaves = $addLeave;
                                   $userLeaveBalance->created_by = $employee->created_by;
                              }
                              else
                              {
                                   $userLeaveBalance->pending_leaves = ($userLeaveBalance->pending_leaves + $addLeave);
                              }

                              $userLeaveBalance->save();
                              // Add Leave Balance

                              // Add Leave Balance Year
                              $currentYear = date('Y');
                              $userLeaveBalanceYear = UserLeaveBalanceYear::where([
                                   ["user_id", "=", $employee->id],
                                   ["leave_type_id", "=", $leaveType->id],
                                   ["leaves_year", "=", $currentYear],
                              ])->first();

                              if (empty($userLeaveBalanceYear))
                              {
                                   $userLeaveBalanceYear = new UserLeaveBalanceYear();

                                   $userLeaveBalanceYear->user_id = $employee->id;
                                   $userLeaveBalanceYear->leave_type_id = $leaveType->id;
                                   $userLeaveBalanceYear->pending_leaves = $addLeave;
                                   $userLeaveBalanceYear->created_by =  $employee->created_by;
                                   $userLeaveBalanceYear->leaves_year = $currentYear;
                              }
                              else
                              {
                                   $userLeaveBalanceYear->pending_leaves = ($userLeaveBalanceYear->pending_leaves + $addLeave);
                              }

                              $userLeaveBalanceYear->save();
                              // Add Leave Balance


                              Log::channel('employee_leave_balance_operations_log')->info("Added Monthly Leave Balance of employee of employee $employee->id - $employee->name", [
                                   "employee_id" => $employee->id,
                                   "employee_type_id" => $leaveType->id,
                                   "employee_type_name" => $leaveType->title,
                                   "added_leave_balance" => $addLeave,
                              ]);
                         }

                         Employee::where("id", $employee->id)->update(['confirm_probation_period' => 1]);

                         Log::channel('employee_leave_balance_operations_log')->info("changed employee probation period to permenent $employee->name", [
                              "employee_id" => $employee->id,
                              "employee_type_id" => $leaveType->id,
                              "employee_type_name" => $leaveType->title,
                         ]);

                         $leaveAddedCount++;
                    }

                    if (date("Y-m-d") == Carbon::now()->startOfMonth()->format("Y-m-d") || true)
                    {
                         $leaveTypes = LeaveType::where("play_slab_id", $employee->play_slab_id)->where('created_by', '=', $employee->created_by)->get();

                         foreach ($leaveTypes as $leaveType)
                         {
                              $addLeave = ($leaveType->days / 12);
                              // UserLeaveBalance::where("leave_type_id", $data->leave_type_id)->where("user_id", $employee->id)->increment('pending_leaves', $addLeave);

                              // Add Leave Balance
                              $userLeaveBalance = UserLeaveBalance::where([
                                   ["user_id", "=", $employee->id],
                                   ["leave_type_id", "=", $leaveType->id],
                              ])->first();

                              if (empty($userLeaveBalance))
                              {
                                   $userLeaveBalance = new UserLeaveBalance();

                                   $userLeaveBalance->user_id = $employee->id;
                                   $userLeaveBalance->leave_type_id = $leaveType->id;
                                   $userLeaveBalance->pending_leaves = $addLeave;
                                   $userLeaveBalance->created_by = $employee->created_by;
                              }
                              else
                              {
                                   $userLeaveBalance->pending_leaves = ($userLeaveBalance->pending_leaves + $addLeave);
                              }

                              $userLeaveBalance->save();
                              // Add Leave Balance

                              // Add Leave Balance Year
                              $currentYear = date('Y');
                              $userLeaveBalanceYear = UserLeaveBalanceYear::where([
                                   ["user_id", "=", $employee->id],
                                   ["leave_type_id", "=", $leaveType->id],
                                   ["leaves_year", "=", $currentYear],
                              ])->first();

                              if (empty($userLeaveBalanceYear))
                              {
                                   $userLeaveBalanceYear = new UserLeaveBalanceYear();

                                   $userLeaveBalanceYear->user_id = $employee->id;
                                   $userLeaveBalanceYear->leave_type_id = $leaveType->id;
                                   $userLeaveBalanceYear->pending_leaves = $addLeave;
                                   $userLeaveBalanceYear->created_by = $employee->created_by;
                                   $userLeaveBalanceYear->leaves_year = $currentYear;
                              }
                              else
                              {
                                   $userLeaveBalanceYear->pending_leaves = ($userLeaveBalanceYear->pending_leaves + $addLeave);
                              }

                              $userLeaveBalanceYear->save();
                              // Add Leave Balance

                              Log::channel('employee_leave_balance_operations_log')->info("Added Monthly Leave Balance of employee $employee->id - $employee->name", [
                                   "employee_id" => $employee->id,
                                   "employee_type_id" => $leaveType->id,
                                   "employee_type_name" => $leaveType->title,
                                   "added_leave_balance" => $addLeave,
                              ]);

                              $leaveAddedCount++;
                         }
                    }
               }
               return "Total $leaveAddedCount Employees Leave Added.";
          }
          catch (Exception | Throwable $ex)
          {
               // dd($ex);
               Log::channel('employee_leave_balance_operations_log')->error("Error in Monthly Leave Balance add", [
                    "exception" => $ex->getMessage(),
                    "line_no" => $ex->getLine(),
                    "filename" => $ex->getFile(),
               ]);
               return 0;
          }
          return 1;
     }

