<script>
    $(document).ready(function() {

        $('.salaryAmountValidation').on('input keypress keyup paste dragover', function(e) {
            // Check if the entered value is a valid number
            var inputValue = $(this).val() + String.fromCharCode(e.which);
            if (!$.isNumeric(inputValue)) {
                // Prevent the input if it's not a number
                e.preventDefault();
            }
        });

        $('#geofencing_status').change(function() {
            if ($(this).prop('checked')) {
                $(".geofencing_inputs_div").show();
            } else {
                $(".geofencing_inputs_div").hide();
            }
        });

        //get district
        $.ajax({
            type: "get",
            url: "{{ url('get-state-by-country') }}" + '/' + ($('#country_name').val() ?? ""),
            success: function(data) {
                var options = '<option value="">Please select State</option>';
                $.each(data, function(index, object) {
                    if ('{{ $branch->state_name }}' == object.state_title) {
                        var selected = 'selected';
                    } else {
                        var selected = '';
                    }
                    options += '<option ' + selected + ' value="' + object.state_title +
                        ' ">' + object.state_title + '</option>';
                });
                $('#state_name').html(options);
            },
            error: function(data) {
                console.log('Error:', data);
            }
        });

        setTimeout(function() {
            //get district
            $.ajax({
                type: "get",
                url: "{{ url('get-district-by-state-name') }}" + '/' + ($('#state_name')
                .val() ?? ""),
                success: function(data) {
                    var options = '<option value="">Please select District</option>';
                    $.each(data, function(index, object) {
                        if ('{{ $branch->district_name }}' == object
                            .district_title) {
                            var selected = 'selected';
                        } else {
                            var selected = '';
                        }
                        options += '<option ' + selected + ' value="' + object
                            .district_title +
                            ' ">' + object.district_title + '</option>';
                    });
                    $('#district_name').html(options);
                },
                error: function(data) {
                    console.log('Error:', data);
                }
            });
        }, 1000);

        //get cityes

        setTimeout(function() {
            $.ajax({
                type: "get",
                url: "{{ url('get-city-by-district-name') }}" + '/' + ($('#district_name')
                    .val() ?? ""),
                success: function(data) {
                    var options = '<option value="">Please select City</option>';
                    $.each(data, function(index, object) {
                        if ('{{ $branch->city_name }}' == object.name) {
                            var selected = 'selected';
                        } else {
                            var selected = '';
                        }
                        options += '<option ' + selected + ' value="' + object
                            .name + '">' + object.name + '</option>';
                    });
                    $('#city_name').html(options);
                },

                error: function(data) {
                    console.log('Error:', data);
                }
            });
        }, 2000);

        $("#country_name").change(function() {
            $.ajax({
                type: "get",
                url: "{{ url('get-state-by-country') }}" + '/' + this.value,
                success: function(data) {
                    var options = '<option value="">Please select State</option>';
                    $.each(data, function(index, object) {
                        options += '<option value="' + object.state_title +
                            '">' +
                            object.state_title + '</option>';
                    });
                    $('#state_name').html(options);
                },
                error: function(data) {
                    console.log('Error:', data);
                }
            });
        });
        //on chnage ajax

        $("#state_name").change(function() {
            $.ajax({
                type: "get",
                url: "{{ url('get-district-by-state-name') }}" + '/' + this.value,
                success: function(data) {
                    var options = '<option value="">Please select District</option>';
                    $.each(data, function(index, object) {
                        options += '<option value="' + object.district_title +
                            '">' +
                            object.district_title + '</option>';
                    });
                    $('#district_name').html(options);
                },
                error: function(data) {
                    console.log('Error:', data);
                }
            });
        });
        //get City
        $("#district_name").change(function() {
            $.ajax({
                type: "get",
                url: "{{ url('get-city-by-district-name') }}" + '/' + this.value,
                success: function(data) {
                    var options = '<option value="">Please select City</option>';
                    $.each(data, function(index, object) {
                        options += '<option value="' + object.name + '">' + object
                            .name + '</option>';
                    });
                    $('#city_name').html(options);
                },
                error: function(data) {
                    console.log('Error:', data);
                }
            });
        });

    });
</script>
