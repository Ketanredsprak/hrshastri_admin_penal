<script>
    $(document ).ready(function() {

        $("#commonModal").on('keyup','#amountinput',function() {
            commutingdata = $('#select_commuting_type').val();
            if(commutingdata == ''){
                alert('Please first select commuting type');
                $('#amountinput').val('');
            }else{
                //ajax call to 
                $.ajax({
                    type: "GET",
                    url: "{{ url('get_getAmount')}}",
                    data: {commutingtype:commutingdata,kilometer:$(this).val()},
                    cache: true,
                    success: function(data){
                        $('#total_amount').val(data);
                        $('#fix_amount').val(data);
                    } 
                });

            }
        });

        $("#commonModal").on('keyup','.amountinputCal',function() {
                totalamount = $('#total_amount').val();
                var fix_total_amount = $('#fix_total_amount').val();
                var fix_not_Actual_total_amount = $('#fix_not_Actual_total_amount').val();
            
                $.ajax({
                    type: "GET",
                    url: "{{ url('get_getAmountinput')}}",
                    data: {amountinput:$(this).val(),fix_not_Actual_total_amount:fix_not_Actual_total_amount},
                    cache: false,
                    success: function(data){
                        $('#total_amount').val(data);
                    } 
                });
        });
        
    });

    //getVisitType
    function getVisitType(getVisitType) {
        $.ajax({
            type: "GET",
            url: "{{ url('get_getVisitTypeexpense')}}",
            data: {getVisitType:getVisitType},
            cache: true,
            success: function(data){
                
                if(data != 0){
                    $('.select_commuting_type').addClass('d-none');
                    $('.kilomiter').addClass('d-none');
                    
                    var totalamount = 0;
                    var isnot_actotalamount = 0;

                    $.each(data, function(key, value){   
                        
                        var checkbox = 0;
                        
                        var disable = 0;
                        var readonly = 'readonly';
                        var readonlyname = 'readonly';
                        disable  = 'disabled';
                        var is_actual_value = 0;
                        totalamount += parseInt(value.amount);
                        
                        $('#total_amount').val(totalamount)

                        $('#fix_total_amount').val(totalamount)    
                        
                        if(value.is_actual == 1 )
                        {
                            checkbox = 'checked';
                            is_actual_value = 1;
                            readonly = 0;
                        }else{
                            
                            isnot_actotalamount += parseInt(value.amount);

                            $('#fix_not_Actual_total_amount').val(isnot_actotalamount)    
                        }
                        
                        $('.add_expense_dive').append(
                            
                            `<div class="row">
                                    <div class="form-group col-lg-4"> 
                                        {{ Form::label('Expense', __('Expense Name'), ['class' => 'col-form-label']) }}
                                        <input type="text" ` + readonlyname + ` name="expens_name[]" class="form-control" placeholder="Please expense name" value="`+ value.expense_data.name +`">
                                    </div>
                                    <div class="form-group col-lg-4"> 
                                        {{ Form::label('Expense', __('Expense amount'), ['class' => 'col-form-label']) }}
                                        <input type="number" ` + readonly + ` name="expens_amount[]" class="form-control amountinputCal" required placeholder="Please expense amount" value="`+ value.amount +`">
                                    </div>
                                    <div class="form-group col-lg-4"> 

                                        <input type="hidden" name="hidden_expense_is_actual[]" class="form-check-input" required" value="`+ is_actual_value +`">

                                        <input type="checkbox" ` + checkbox + ` onclick="return false"  name="expense_is_actual[]" class="form-check-input" required" value="`+ is_actual_value +`">
                                        {{ Form::label('Expense', __('is actual'), ['class' => 'col-form-label']) }}
                                    </div>
                                </div>
                            `
                        );
                    });

                }else{
                    $('.select_commuting_type').removeClass('d-none');
                    $('.kilomiter').removeClass('d-none');
                    $('.add_expense_dive').html('');
                }

            } 
        });

        $('#amountinput').val('');
        $('#total_amount').val(0);
        $("#select_commuting_type").prop("selectedIndex", 0);

    
    }
    
    function selectCommutingType(commutingtype){
        $('#amountinput').val('');
        $('#total_amount').val(0);
    }    

</script>
